# ==========================================
# UPWISE Server Environment Configuration
# ==========================================

# Application Port
PORT=5000
NODE_ENV=development

# Groq AI Provider (Primary Chatbot Engine)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Secondary AI & Tool Integrations (Optional)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# Database & Authentication
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/upwise?schema=public"
JWT_SECRET=upwise-editorial-secret-key-2026

