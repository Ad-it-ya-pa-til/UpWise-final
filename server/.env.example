# ==========================================
# UPWISE Server Environment Configuration
# ==========================================

# Application Port
PORT=5000
NODE_ENV=development

# Groq AI Provider (Primary Chatbot Engine)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=
# Verified against Groq's live catalogue on 2026-10-30.
# Other currently available chat models include: openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# Secondary AI & Tool Integrations (Optional)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# Database & Authentication
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/upwise?schema=public"
JWT_SECRET=upwise-editorial-secret-key-2026

